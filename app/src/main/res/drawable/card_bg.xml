<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#24304A" /><stroke android:width="3dp" android:color="@color/accent2" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#24304A" /><stroke android:width="3dp" android:color="@color/accent2" /><corners android:radius="10dp" /></shape>
    </item>
    <item><shape><solid android:color="@color/card" /><corners android:radius="10dp" /></shape></item>
</selector>
