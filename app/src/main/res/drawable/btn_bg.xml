<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="24dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#3A4766" /><stroke android:width="2dp" android:color="@color/accent2" /><corners android:radius="24dp" /></shape>
    </item>
    <item><shape><solid android:color="#273046" /><corners android:radius="24dp" /></shape></item>
</selector>
